{
  "name": "@tabletop-format/tools",
  "version": "0.1.0",
  "description": "Open game format for living card games \u2014 schemas, validator, importers (CSV, NRDB-family), semantic diff, PnP/TTS exporters.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "fmt": "tools/fmt.mjs"
  },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "demo": "./demo.sh",
    "typecheck": "tsc -p tsconfig.json",
    "validate:ember": "node tools/fmt.mjs validate examples/ember",
    "test": "./e2e.sh",
    "test:affinity": "node tools/test-affinity-bridge.mjs",
    "test:affinity:live": "node tools/affinity-live-stress.mjs",
    "test:card-design": "node tools/test-card-design.mjs examples/_fixtures/netrunner-sg",
    "test:design-engines": "node tools/test-design-engines.mjs examples/_fixtures/netrunner-sg",
    "test:forge-project": "node tools/test-forge-project.mjs",
    "test:forge-project:server": "node tools/test-forge-project-server.mjs",
    "test:workbook": "node tools/test-workbook.mjs",
    "test:adapters": "node tools/check-adapters.mjs",
    "test:security": "node tools/security-check.mjs",
    "test:project-access": "node tools/test-project-access.mjs",
    "test:project-ref": "node tools/test-project-ref.mjs",
    "test:project-reindex": "node tools/test-project-reindex.mjs",
    "test:hosted-project-reindex": "node tools/test-hosted-project-reindex.mjs",
    "test:private-cache": "node tools/test-private-cache-and-stale-index.mjs",
    "test:local-private-preview": "node tools/test-local-private-preview.mjs",
    "test:store1-forgejo": "node tools/test-store1-forgejo.mjs",
    "test:fixture-discovery": "node tools/test-fixture-discovery.mjs",
    "test:ui": "node tools/ui-smoke.mjs",
    "test:ui-preview-assets": "node tools/ui-preview-assets.mjs",
    "test:ui-sheets": "node tools/ui-sheets-connector.mjs",
    "test:ui-exports": "node tools/ui-export-selection.mjs",
    "test:ui-recovery": "node tools/ui-draft-recovery.mjs",
    "test:ui-artwork": "node tools/ui-artwork-loading.mjs",
    "test:csv-mapping": "node tools/test-csv-mapping.mjs",
    "test:nandeck": "node tools/test-nandeck-layout.mjs",
    "test:squib": "node tools/test-squib.mjs",
    "test:svg-design": "node tools/test-svg-design.mjs",
    "test:component-design": "node tools/test-component-design.mjs",
    "test:tts-components": ".venv/bin/python tools/test_tts_components.py",
    "test:ttpg": ".venv/bin/python tools/test_ttpg_export.py",
    "test:rulebook-publication": "node tools/test-rulebook-publication.mjs",
    "build:rulebook-publication": "node tools/build-rulebook-publication.mjs examples/_fixtures/netrunner-sg output/pdf/netrunner-sg-rulebook-publication",
    "setup:dev": "node tools/setup-dev.mjs",
    "doctor": "node tools/doctor.mjs",
    "test:dev": "node tools/test-dev.mjs",
    "smoke:alpha": "node tools/alpha-readiness.mjs",
    "test:production-config": "node tools/production-config-check.mjs",
    "release:vault": "node tools/release-vault.mjs",
    "test:release-vault": "node tools/test-release-vault.mjs",
    "test:release-vault-cli": "node tools/test-release-vault-cli.mjs",
    "test:release-vault-snapshot": "node tools/test-release-vault-snapshot.mjs",
    "test:backup-guards": "node tools/test-backup-guards.mjs",
    "test:production-preflight": "node tools/test-deploy-preflight.mjs",
    "test:preview-assets": "node tools/test-preview-assets.mjs",
    "deploy:bootstrap": "node deploy/bootstrap.mjs",
    "test:deploy-bootstrap": "node tools/test-deploy-bootstrap.mjs",
    "pilot:invite": "node tools/pilot-invite.mjs",
    "pilot:account": "node tools/pilot-account.mjs",
    "test:pilot-invite": "node tools/test-pilot-invite-registration.mjs",
    "test:source-assets": "node tools/test-source-assets.mjs",
    "test:repository-file": "node tools/test-repository-file.mjs",
    "test:art-library": "node tools/test-art-library.mjs",
    "test:print-ready": ".venv/bin/python tools/test_print_ready.py",
    "package:sheets-addon": "node tools/package-sheets-addon.mjs",
    "test:sheets-package": "node tools/test-sheets-addon-package.mjs",
    "deploy:preflight": "node deploy/preflight.mjs --env deploy/.env --online",
    "pilot:report": "node tools/pilot-report.mjs",
    "test:pilot-report": "node tools/test-pilot-report.mjs",
    "test:forgejo:disposable": "./tools/disposable-forgejo-check.sh",
    "test:restore:disposable": "./tools/disposable-restore-drill.sh",
    "test:production-image": "./tools/qualify-production-image.sh",
    "launch:gate": "./launch-gate.sh",
    "export:pnpink": "node tools/fmt.mjs export pnpink examples/_fixtures/netrunner-sg tmp/pnpink",
    "split:card-design": "node tools/split-layout-families.mjs",
    "test:quick": "node tools/fmt.mjs validate examples/ember && node tools/fmt.mjs validate examples/harbor-nine && node tools/fmt.mjs validate examples/netrunner-urbp",
    "vtt:up": "docker compose -f deploy/docker-compose.vtt.yml up -d",
    "vtt:down": "docker compose -f deploy/docker-compose.vtt.yml down",
    "test:ui-print": "node tools/ui-home-print.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0",
    "js-yaml": "^4.1.0",
    "pg": "8.23.0",
    "playwright-core": "^1.55.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@google/clasp": "3.4.1",
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.20.0 <25"
  }
}
