{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.example.dev/schemas/pnpink-adapter.schema.json",
  "title": "PnPInk card design adapter",
  "type": "object",
  "required": ["version", "kind", "upstream", "template", "families"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "kind": { "const": "pnpink" },
    "description": { "type": "string" },
    "upstream": {
      "type": "object",
      "required": ["repository", "license", "tested_tag"],
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "license": { "const": "MIT" },
        "tested_tag": { "type": "string", "minLength": 1 }
      }
    },
    "template": {
      "type": "string",
      "pattern": "^templates/card-design/[A-Za-z0-9_./-]+\\.svg$"
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "specimen", "bbox", "fields"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "specimen": { "type": "string", "minLength": 1 },
          "bbox": { "type": "string", "minLength": 1 },
          "fields": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
