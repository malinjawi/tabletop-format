{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.example.dev/schemas/rulebook-publications.schema.json",
  "title": "Rulebook publication registry",
  "description": "Registers designed books that are versioned alongside a game. Each document may be rendered by Forge or opened in a native publishing tool.",
  "type": "object",
  "required": ["version", "active", "publications"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "active": { "$ref": "#/$defs/id" },
    "publications": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/publication" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "safePath": { "type": "string", "pattern": "^rules/publications/[A-Za-z0-9_./-]+$" },
    "output": {
      "type": "object",
      "required": ["id", "label", "format"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "format": { "enum": ["pdf", "html", "json", "zip"] }
      }
    },
    "editor": {
      "type": "object",
      "required": ["id", "type", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["forge-layout", "affinity-publisher", "indesign", "scribus", "html-css"] },
        "label": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/safePath" },
        "roundtrip": { "enum": ["native", "import-only", "export-only", "none"] }
      }
    },
    "publication": {
      "type": "object",
      "required": ["id", "label", "kind", "status", "source", "editors", "outputs"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["learn-to-play", "rules-reference", "scenario-book", "player-aid", "lore-book", "other"] },
        "status": { "enum": ["active", "draft", "archived"] },
        "source": { "$ref": "#/$defs/safePath" },
        "editors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/editor" } },
        "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/output" } }
      }
    }
  }
}
