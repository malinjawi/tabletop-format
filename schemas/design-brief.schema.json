{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.example.dev/schemas/design-brief.schema.json",
  "title": "Design brief",
  "description": "The versioned intent and smallest playable question for an early game design.",
  "type": "object",
  "required": ["schema_version", "status", "starting_point", "spark", "design_intent", "mvp"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "status": {
      "type": "string",
      "enum": ["idea", "prototype", "playtesting", "development"]
    },
    "starting_point": {
      "type": "string",
      "enum": ["experience", "mechanism", "theme", "existing_prototype"]
    },
    "spark": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "Unpolished source idea. It is deliberately allowed to be messy."
    },
    "design_intent": {
      "type": "object",
      "required": ["player_experience"],
      "additionalProperties": false,
      "properties": {
        "player_experience": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "audience": { "type": "string", "maxLength": 500 },
        "core_activity": { "type": "string", "maxLength": 1000 },
        "distinguishing_idea": { "type": "string", "maxLength": 1000 },
        "player_goal": { "type": "string", "maxLength": 1000 }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "players_min": { "type": "integer", "minimum": 1, "maximum": 99 },
        "players_max": { "type": "integer", "minimum": 1, "maximum": 99 },
        "playtime_minutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
        "minimum_age": { "type": "integer", "minimum": 1, "maximum": 99 }
      }
    },
    "mvp": {
      "type": "object",
      "required": ["playable_slice"],
      "additionalProperties": false,
      "properties": {
        "playable_slice": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "question": { "type": "string", "maxLength": 1000 },
        "first_test": { "type": "string", "maxLength": 1000 },
        "success_signal": { "type": "string", "maxLength": 1000 }
      }
    }
  }
}
