{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.example.dev/schemas/rights.schema.json",
  "title": "Forge per-file rights manifest",
  "type": "object",
  "required": ["format", "version", "project", "default", "files"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "forge-rights" },
    "version": { "const": 1 },
    "project": {
      "type": "object",
      "required": ["license", "owner"],
      "additionalProperties": false,
      "properties": {
        "license": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "trademark_notice": { "type": ["string", "null"] },
        "source_project": { "type": "string" },
        "source_ref": { "type": "string" },
        "source_license": { "type": "string" },
        "derivative": { "type": "boolean" },
        "release_permission": { "enum": ["license", "documented", "unverified"] }
      }
    },
    "default": { "$ref": "#/$defs/right" },
    "files": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/right" },
          {
            "type": "object",
            "required": ["paths"],
            "properties": {
              "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "right": {
      "type": "object",
      "required": ["license", "status", "copyright", "redistribution"],
      "properties": {
        "license": { "type": "string", "minLength": 1 },
        "status": { "enum": ["original", "commissioned", "licensed", "public-domain", "permission-only", "unknown", "generated"] },
        "copyright": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "redistribution": { "enum": ["allowed", "restricted", "private-only"] },
        "source": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
