{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.example.dev/schemas/jam.schema.json",
  "title": "Governed game jam",
  "description": "A time-boxed community design event whose server lifecycle is derived from explicit UTC boundaries. Entries submitted through Forge pin an immutable, rights-checked release; the optional entries list contains curated or legacy host entries.",
  "type": "object",
  "required": ["id", "title", "theme"],
  "additionalProperties": false,
  "anyOf": [
    { "required": ["starts_at", "submissions_close_at", "judging_ends_at", "results_at"] },
    { "required": ["starts", "ends", "status"] }
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "title": { "type": "string", "minLength": 1 },
    "theme": { "type": "string", "minLength": 1 },
    "tagline": { "type": "string" },
    "host": { "type": "string" },
    "timezone": { "const": "UTC" },
    "organizers": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "starts_at": { "type": "string", "format": "date-time" },
    "submissions_close_at": { "type": "string", "format": "date-time" },
    "judging_ends_at": { "type": "string", "format": "date-time" },
    "results_at": { "type": "string", "format": "date-time" },
    "status_override": { "type": "string", "enum": ["scheduled", "open", "judging", "frozen", "published"] },
    "starts": { "type": "string", "format": "date" },
    "ends": { "type": "string", "format": "date" },
    "status": { "type": "string", "enum": ["upcoming", "running", "judging", "complete"] },
    "team_rules": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "max_members": { "type": "integer", "minimum": 1, "maximum": 100 },
        "one_entry_per_game": { "type": "boolean" }
      }
    },
    "submission": {
      "type": "object", "required": ["kind"], "additionalProperties": false,
      "properties": {
        "kind": { "const": "forge-release" },
        "resubmission_before_close": { "type": "boolean" },
        "external_entries": { "type": "boolean" }
      }
    },
    "constraints": {
      "type": "object",
      "description": "Machine-checkable entry rules enforced by fmt jam-check and repeated against the exact release at submission.",
      "additionalProperties": false,
      "properties": {
        "max_cards": { "type": "integer", "minimum": 1 },
        "min_cards": { "type": "integer", "minimum": 1 },
        "max_deck_size": { "type": "integer", "minimum": 1 },
        "required_license": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "theme_word_required": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "judging": { "type": "array", "items": { "type": "string" } },
    "prizes": { "type": "array", "items": { "type": "string" } },
    "entries": {
      "type": "array",
      "items": {
        "type": "object", "required": ["title", "author"], "additionalProperties": false,
        "properties": {
          "game_id": { "type": "string" },
          "title": { "type": "string" },
          "author": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "submitted": { "type": "string", "format": "date" },
          "award": { "type": "string" }
        }
      }
    }
  }
}
