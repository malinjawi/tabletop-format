{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.example.dev/schemas/prototype.schema.json",
  "title": "First playable prototype",
  "description": "A low-fidelity, component-neutral test plan: what to gather, how to set it up, what players do, and what the designer is trying to learn.",
  "type": "object",
  "required": ["schema_version", "status", "iteration", "question", "players", "duration_minutes", "materials", "setup", "procedure", "end_condition", "observation"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "status": { "type": "string", "enum": ["draft", "ready", "testing", "retired"] },
    "iteration": { "type": "integer", "minimum": 1 },
    "question": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "players": {
      "type": "object",
      "required": ["min", "max"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": "integer", "minimum": 1, "maximum": 99 },
        "max": { "type": "integer", "minimum": 1, "maximum": 99 }
      }
    },
    "duration_minutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "name", "quantity"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_]{1,63}$" },
          "kind": {
            "type": "string",
            "enum": ["card", "token", "die", "board", "tile", "pawn", "tracker", "paper", "timer", "other"]
          },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "quantity": { "type": "integer", "minimum": 1, "maximum": 9999 },
          "notes": { "type": "string", "maxLength": 1000 }
        }
      }
    },
    "setup": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "procedure": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "end_condition": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "observation": {
      "type": "object",
      "required": ["prompt"],
      "additionalProperties": false,
      "properties": {
        "prompt": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "success_signal": { "type": "string", "maxLength": 1000 }
      }
    }
  }
}
