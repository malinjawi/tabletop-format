{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.example.dev/schemas/source-assets.schema.json",
  "title": "Forge production source package manifest",
  "description": "Declares the editable source packages and external tools behind a complete tabletop game without claiming every native format is losslessly parseable.",
  "type": "object",
  "required": ["format", "version", "packages"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "forge-source-assets" },
    "version": { "const": 1 },
    "packages": {
      "type": "array",
      "items": { "$ref": "#/$defs/package" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "path": {
      "type": "string",
      "pattern": "^(?:assets|templates|rules|setups|boards|components|design)/[A-Za-z0-9_ .@()/+-]+(?:/[A-Za-z0-9_ .@()+-]+)*$"
    },
    "file": {
      "type": "object",
      "required": ["path", "role"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "role": { "type": "string", "minLength": 1, "maxLength": 80 },
        "primary": { "type": "boolean" },
        "optional": { "type": "boolean" }
      }
    },
    "adapter": {
      "type": "object",
      "required": ["id", "version", "direction"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "integer", "minimum": 1 },
        "direction": { "enum": ["native", "round-trip", "import-only", "export-only", "reference-only"] },
        "application": { "type": "string", "minLength": 1, "maxLength": 100 },
        "tested_version": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "external": {
      "type": "object",
      "required": ["provider", "url"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 100 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "asset_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "terms_url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "package": {
      "type": "object",
      "required": ["id", "label", "kind", "status", "adapter", "distribution", "targets", "source_files"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "kind": { "enum": ["card-design", "rulebook", "board", "token", "miniature", "model-3d", "audio", "font", "table-setup", "reference", "other"] },
        "status": { "enum": ["active", "experimental", "archived"] },
        "adapter": { "$ref": "#/$defs/adapter" },
        "distribution": { "enum": ["release", "reference-only", "private-only"] },
        "targets": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["browser", "print", "rulebook", "manufacturing", "tabletop-simulator", "tabletop-club", "virtualtabletop", "3d-print", "archive"] }
        },
        "source_files": {
          "type": "array",
          "items": { "$ref": "#/$defs/file" }
        },
        "previews": {
          "type": "array",
          "items": { "$ref": "#/$defs/file" }
        },
        "external": { "$ref": "#/$defs/external" },
        "instructions": { "type": "string", "minLength": 1, "maxLength": 500 }
      },
      "anyOf": [
        { "properties": { "source_files": { "type": "array", "minItems": 1 } } },
        { "properties": { "external": { "$ref": "#/$defs/external" } }, "required": ["external"] }
      ]
    }
  }
}
