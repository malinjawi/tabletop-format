{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.example.dev/schemas/production.schema.json",
  "title": "Forge production template",
  "description": "A renderer-neutral contract that binds canonical card or printing fields to editable objects in a production SVG. Forge preview, export, and optional native-editor adapters consume the same bindings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "card", "templates"],
  "properties": {
    "enabled": { "type": "boolean", "default": true },
    "preferred": { "type": "boolean", "default": false },
    "schema_version": { "const": 1 },
    "kind": { "const": "forge-production" },
    "private_only": { "type": "boolean", "default": false },
    "notice": { "type": "string" },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["w_mm", "h_mm"],
      "properties": {
        "w_mm": { "type": "number", "exclusiveMinimum": 0 },
        "h_mm": { "type": "number", "exclusiveMinimum": 0 },
        "radius_mm": { "type": "number", "minimum": 0 }
      }
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/template" }
    }
  },
  "$defs": {
    "safeId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "match": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Za-z0-9_.-]+$" },
      "additionalProperties": {
        "oneOf": [
          { "type": ["string", "number", "boolean", "null"] },
          {
            "type": "array",
            "minItems": 1,
            "items": { "type": ["string", "number", "boolean", "null"] }
          }
        ]
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "layer"],
      "properties": {
        "source": { "enum": ["card", "printing"] },
        "field": { "type": "string", "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$" },
        "layer": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "optional": { "type": "boolean" },
        "mode": { "enum": ["plain", "token-text", "choice"] },
        "token": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "font_family": { "type": "string", "minLength": 1 },
        "font_postscript": { "type": "string", "minLength": 1 },
        "font_weight": { "type": "integer", "minimum": 100, "maximum": 900 },
        "transform": { "enum": ["type-label", "join", "uppercase", "lowercase", "json"] },
        "separator": { "type": "string" },
        "preflight": { "type": "boolean" }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signature", "values"],
      "properties": {
        "signature": { "type": "string", "pattern": "^fnv1a:[0-9a-f]{8}$" },
        "values": { "type": "object" }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "renderer", "match", "template", "bindings", "baselines"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "renderer": { "const": "svg" },
        "match": { "$ref": "#/$defs/match" },
        "template": { "$ref": "#/$defs/relativePath" },
        "resources": {
          "type": "array",
          "items": { "$ref": "#/$defs/relativePath" },
          "uniqueItems": true
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/binding" }
        },
        "baselines": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/baseline" }
        }
      }
    }
  }
}
