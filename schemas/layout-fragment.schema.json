{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.example.dev/schemas/layout-fragment.schema.json",
  "title": "Card design component or family fragment",
  "type": "object",
  "required": ["regions"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "regions": {
      "type": "array",
      "items": { "$ref": "https://spec.example.dev/schemas/layout.schema.json#/$defs/region" }
    },
    "remove_regions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
