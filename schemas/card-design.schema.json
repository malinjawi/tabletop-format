{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.example.dev/schemas/card-design.schema.json",
  "title": "Composable card design manifest",
  "description": "A version-controlled catalog that composes one physical card design from a shared design system, reusable components, and a card-family template. Paths are relative to the game root and must remain under templates/card-design/.",
  "type": "object",
  "required": ["version", "system", "families", "region_order"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "system": { "$ref": "#/$defs/path" },
    "legacy_source": { "type": "string", "pattern": "^templates/[A-Za-z0-9_./-]+\\.(?:yaml|yml)$" },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/family" }
    },
    "region_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^templates/card-design/[A-Za-z0-9_./-]+\\.(?:yaml|yml)$"
    },
    "component": {
      "type": "object",
      "required": ["id", "label", "source", "applies_to"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "source": { "$ref": "#/$defs/path" },
        "applies_to": {
          "oneOf": [
            { "const": "*" },
            { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" } }
          ]
        }
      }
    },
    "family": {
      "type": "object",
      "required": ["id", "label", "match", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "match": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "oneOf": [
              { "type": ["string", "number", "boolean", "null"] },
              { "type": "array", "minItems": 1, "items": { "type": ["string", "number", "boolean", "null"] } }
            ]
          }
        },
        "source": { "$ref": "#/$defs/path" },
        "specimens": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
