{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.example.dev/schemas/game.schema.json",
  "title": "Game",
  "description": "Root metadata for a game project (game.yaml). Rules identity for the project as a whole.",
  "type": "object",
  "required": ["format_version", "id", "title", "license"],
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "type": "string",
      "description": "Version of THIS format spec the project conforms to (semver).",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "id": {
      "type": "string",
      "description": "Stable opaque project ID. Lowercase kebab-case. Never changes after creation.",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "theme": {
      "type": "string",
      "description": "Card-layout theme for HTML/CSS rendering: a built-in theme name (themes/<name>.css) or 'local' to use templates/card.css. Optional; defaults to classic."
    },
    "genre": { "type": "string", "description": "Primary genre for discovery (e.g. deckbuilder, trick-taking, dungeon-crawl). Optional." },
    "tags": { "type": "array", "items": { "type": "string" }, "description": "Free-form discovery tags (mechanics, themes). Optional." },
    "version": {
      "type": "string",
      "description": "Version of the GAME content (semver). Releases tag this.",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "license": {
      "type": "string",
      "description": "License for the game's expression (text, names, structure). SPDX identifier or CC short code.",
      "examples": ["CC-BY-4.0", "CC-BY-SA-4.0", "CC-BY-NC-SA-4.0", "CC0-1.0", "proprietary"]
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string" },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "attribution": {
      "type": "object",
      "description": "Present when this game is a remix/fork. Preserves the attribution chain.",
      "required": ["source_id", "source_title"],
      "additionalProperties": false,
      "properties": {
        "source_id": { "type": "string" },
        "source_title": { "type": "string" },
        "source_url": { "type": "string", "format": "uri" },
        "source_license": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "players": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": { "type": "integer", "minimum": 1 },
        "max": { "type": "integer", "minimum": 1 }
      }
    },
    "playtime_minutes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": { "type": "integer", "minimum": 1 },
        "max": { "type": "integer", "minimum": 1 }
      }
    },
    "default_provenance": {
      "$ref": "provenance.schema.json"
    },
    "attribute_definitions": {
      "type": "array",
      "description": "Declares the game-specific card attributes (e.g. cost, power) so tools can validate, template-bind, and diff them with types.",
      "items": {
        "type": "object",
        "required": ["key", "type"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9_]{1,32}$" },
          "name": { "type": "string", "description": "Display name." },
          "type": { "type": "string", "enum": ["integer", "number", "string", "boolean"] },
          "required": { "type": "boolean", "default": false },
          "description": { "type": "string" }
        }
      }
    },
    "symbols": {
      "type": "array",
      "description": "Inline text symbols usable in card text as [key] tags (NRDB convention), mapped to display glyphs/assets.",
      "items": {
        "type": "object",
        "required": ["key"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9_]{1,32}$" },
          "name": { "type": "string" },
          "glyph": { "type": "string", "description": "Unicode fallback glyph used by renderers when no asset is given (e.g. '✦')." },
          "asset": { "type": "string", "description": "Relative path to glyph asset." }
        }
      }
    },
    "type_colors": {
      "type": "object",
      "description": "Per-type render colors — design data, not tool code. Keys are card types; renderers fall back to a default palette for undeclared types.",
      "additionalProperties": {
        "type": "object",
        "required": ["fg", "bg"],
        "additionalProperties": false,
        "properties": {
          "fg": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "bg": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
        }
      }
    }
  }
}
