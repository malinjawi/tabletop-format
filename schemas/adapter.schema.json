{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.example/schemas/adapter.schema.json",
  "title": "Forge adapter catalog",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "version", "stage", "status", "capabilities", "components", "deterministic", "fidelity", "credentials", "network", "limits", "provenance"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
      "name": { "type": "string", "minLength": 2, "maxLength": 80 },
      "version": { "type": "integer", "minimum": 1 },
      "stage": { "enum": ["snapshot-import", "working-copy", "source-adapter", "artifact-export", "publisher"] },
      "status": { "enum": ["stable", "beta", "experimental"] },
      "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["inspect", "import", "export", "round-trip", "publish"] } },
      "components": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
      "tested_upstream": { "type": ["string", "null"] },
      "deterministic": { "type": "boolean" },
      "fidelity": {
        "type": "object", "additionalProperties": false, "required": ["level", "limitations"],
        "properties": { "level": { "enum": ["canonical", "declared-subset", "artifact-only"] },
          "limitations": { "type": "array", "items": { "type": "string" } } }
      },
      "credentials": {
        "type": "object", "additionalProperties": false, "required": ["required", "storage"],
        "properties": { "required": { "type": "boolean" }, "kind": { "type": ["string", "null"] },
          "storage": { "enum": ["none", "user-private", "server-secret"] } }
      },
      "network": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
      "limits": {
        "type": "object", "additionalProperties": false, "required": ["max_bytes", "timeout_ms"],
        "properties": { "max_bytes": { "type": "integer", "minimum": 1 }, "timeout_ms": { "type": "integer", "minimum": 1 } }
      },
      "provenance": { "enum": ["receipt", "embedded", "manifest", "none"] },
      "entrypoint": { "type": "string" }
    }
  }
}
