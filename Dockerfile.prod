# Build with an immutable base, for example:
# docker build --build-arg NODE_IMAGE=node:24-bookworm-slim@sha256:<digest> -f Dockerfile.prod .
ARG NODE_IMAGE
FROM ${NODE_IMAGE}

RUN test -n "${NODE_VERSION}" \
 && test -f /etc/debian_version \
 || (printf 'NODE_IMAGE must be a Debian-family Node image (for example node:24-bookworm-slim)\n' >&2; exit 1)

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates git python3 python3-jsonschema python3-pil python3-reportlab python3-yaml \
 && rm -rf /var/lib/apt/lists/*

# Keep the large OS dependency layer independent of the release revision so
# consecutive source builds reuse it while every final image stays traceable.
ARG FORGE_SOURCE_REVISION
RUN test -n "${FORGE_SOURCE_REVISION}" \
 || (printf 'FORGE_SOURCE_REVISION must be the clean Git commit used for this build\n' >&2; exit 1)

LABEL org.opencontainers.image.source="https://github.com/malinjawi/tabletop-format" \
      org.opencontainers.image.revision="${FORGE_SOURCE_REVISION}" \
      org.opencontainers.image.licenses="Apache-2.0"

WORKDIR /app
RUN mkdir -p /app/data && chown node:node /app/data
COPY --chown=node:node package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY --chown=node:node . .

ENV NODE_ENV=production FORGE_LISTEN_HOST=0.0.0.0
USER node
EXPOSE 8420
CMD ["node", "server.mjs", "--port", "8420"]
