# Build with an immutable base, for example:
# docker build --build-arg NODE_IMAGE=node:22-bookworm-slim@sha256:<digest> -f Dockerfile.prod .
ARG NODE_IMAGE
FROM ${NODE_IMAGE}

RUN test -n "${NODE_VERSION}" \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates git python3 python3-jsonschema python3-pil python3-reportlab python3-yaml \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --chown=node:node package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY --chown=node:node . .

ENV NODE_ENV=production FORGE_LISTEN_HOST=0.0.0.0
USER node
EXPOSE 8420
CMD ["node", "server.mjs", "--port", "8420"]
