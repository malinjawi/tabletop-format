      "show_page_number": true,
      "blocks": [
        { "id": "welcome-title", "type": "heading", "x": 7, "y": 6, "w": 86, "h": 16, "kicker": "WELCOME TO THE NETWORK", "content": "Two sides. Two games. One battlefield.", "style": { "font_size_pt": 24, "color": "#161B25" } },
        { "id": "welcome-body", "type": "text", "x": 7, "y": 24, "w": 54, "h": 27, "content": "Netrunner is an asymmetric game for two players. The Corporation protects agendas behind servers and defensive ice. The Runner probes those servers, installs tools, and steals agendas before the Corporation can score them.\n\nEach side has different cards, actions, information, and risks. Learning the game means learning how those two systems collide.", "style": { "font_size_pt": 10, "columns": 2 } },
        { "id": "welcome-goal", "type": "callout", "x": 65, "y": 24, "w": 28, "h": 21, "heading": "THE SHARED GOAL", "content": "Be the first player to reach 7 agenda points. The Corporation scores installed agendas. The Runner steals agendas by accessing them.", "style": { "font_size_pt": 9, "background": "#E8E2D7", "border": "#E05D32", "padding_mm": 4, "radius_mm": 2 } },
        { "id": "welcome-contents", "type": "component-list", "x": 7, "y": 55, "w": 42, "h": 34, "heading": "IN THIS BOOK", "items": ["Build the first table", "Read cards and spend clicks", "Create and protect servers", "Make a run", "Resolve access", "Use the quick reference"], "style": { "font_size_pt": 9 } },
        { "id": "welcome-cards", "type": "card-grid", "x": 52, "y": 48, "w": 41, "h": 43, "card_ids": ["hedge_fund", "sure_gamble"], "caption": "Every example is linked to the exact card version in this commit.", "style": { "background": "#DCE2E6", "padding_mm": 3, "radius_mm": 2 } }
      ]
    },
