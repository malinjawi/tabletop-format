        { "id": "components-list", "type": "component-list", "x": 7, "y": 22, "w": 37, "h": 40, "heading": "WHAT YOU NEED", "items": ["One Corporation deck", "One Runner deck", "Two identity cards", "Agenda, credit, click, tag, damage, power, and virus counters", "A score area for each player", "Room between the players for remote servers"], "style": { "font_size_pt": 9, "background": "#E7E4DC", "padding_mm": 4, "radius_mm": 2 } },
        { "id": "components-identity", "type": "card-grid", "x": 47, "y": 22, "w": 46, "h": 41, "card_ids": ["haas_bioroid_precision_design", "the_catalyst_convention_breaker"], "caption": "Identity cards begin faceup and define deckbuilding limits and abilities.", "style": { "padding_mm": 3 } },
        { "id": "components-setup", "type": "steps", "x": 7, "y": 67, "w": 86, "h": 24, "heading": "SET UP THE FIRST GAME", "items": ["Choose sides and place both identities faceup.", "Shuffle each deck. The Corporation draws five cards; the Runner draws five.", "Give each player 5 credits. Put the Corporation's HQ, R&D, and Archives in a row.", "Keep the central play area open. New remote servers will be built there during play."], "style": { "font_size_pt": 8.5, "columns": 2, "background": "#E4EBEF", "padding_mm": 4, "radius_mm": 2 } }
      ]
    },
