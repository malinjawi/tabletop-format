        { "id": "run-title", "type": "heading", "x": 6, "y": 6, "w": 88, "h": 12, "kicker": "THE HEART OF NETRUNNER", "content": "The structure of a run", "style": { "font_size_pt": 26, "color": "#FFFFFF" } },
        { "id": "run-intro", "type": "text", "x": 7, "y": 18, "w": 86, "h": 10, "content": "A run is a conversation between the Runner's intent and the Corporation's defenses. Resolve each phase in order.", "style": { "font_size_pt": 10, "color": "#EEE7F2", "align": "center" } },
        { "id": "run-steps", "type": "steps", "x": 10, "y": 32, "w": 80, "h": 43, "heading": "RUN TIMELINE", "items": ["Declare the attacked server.", "Approach the outermost piece of ice.", "The Corporation may rez that ice.", "Encounter it and resolve unbroken subroutines.", "Pass it, then repeat for each piece of ice.", "Approach the server and access cards if the run succeeds."], "style": { "font_size_pt": 10, "columns": 2, "background": "#F2EDF3", "padding_mm": 5, "radius_mm": 3 } },
        { "id": "run-note", "type": "callout", "x": 17, "y": 80, "w": 66, "h": 13, "heading": "THE ACTIVE PLAYER DOES NOT RUSH AHEAD", "content": "Both players receive paid-ability windows during a run. Announce transitions clearly so the other player can respond.", "style": { "font_size_pt": 8.5, "background": "#2B1E30", "border": "#D8B7DE", "color": "#FFFFFF", "padding_mm": 4, "radius_mm": 2 } }
      ]
