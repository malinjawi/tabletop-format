        { "id": "click-card", "type": "card", "x": 8, "y": 20, "w": 33, "h": 52, "card_id": "wildcat_strike", "caption": "A linked live card, not a pasted screenshot.", "style": { "background": "#E3DCE5", "padding_mm": 3, "radius_mm": 2 } },
        { "id": "click-cost", "type": "callout", "x": 47, "y": 19, "w": 46, "h": 18, "heading": "1 — PAY THE COST", "content": "The number beside the credit symbol is the install or play cost. Spend that many credits from your pool.", "style": { "font_size_pt": 9, "background": "#EAE6DE", "border": "#6F3B73", "padding_mm": 4, "radius_mm": 2 } },
        { "id": "click-type", "type": "callout", "x": 47, "y": 40, "w": 46, "h": 18, "heading": "2 — FOLLOW THE CARD TYPE", "content": "Events resolve and enter the heap. Programs, hardware, and resources remain installed in the Runner's rig.", "style": { "font_size_pt": 9, "background": "#EAE6DE", "border": "#6F3B73", "padding_mm": 4, "radius_mm": 2 } },
        { "id": "click-text", "type": "callout", "x": 47, "y": 61, "w": 46, "h": 18, "heading": "3 — RESOLVE THE TEXT", "content": "Card text changes the normal rules. Resolve instructions in order, then check whether any triggered abilities are waiting.", "style": { "font_size_pt": 9, "background": "#EAE6DE", "border": "#6F3B73", "padding_mm": 4, "radius_mm": 2 } },
        { "id": "click-round", "type": "steps", "x": 7, "y": 82, "w": 86, "h": 12, "heading": "A TURN IS A BUDGET", "items": ["Corporation: draw, then spend 3 clicks", "Runner: spend 4 clicks", "Paid abilities may also spend credits or other costs"], "style": { "font_size_pt": 8, "columns": 3, "background": "#DDD3E0", "padding_mm": 3, "radius_mm": 2 } }
      ]
