# STORE-1 CONFIGURATION — LOCKED (SPEC §7 companion; consumed by docker-compose.yml)
# These values are frozen decisions, not suggestions. Change = SPEC amendment.

# --- R2 buckets (create in Cloudflare dash; names are locked) ---
R2_BUCKET_LFS=forge-lfs          # git-lfs objects, key layout lfs/{oid:2}/{oid:2-4}/{oid}
R2_BUCKET_CACHE=forge-cache      # derived renders/exports, sha-addressed, public via CDN
# R2_ACCOUNT_ID=                 # secret — .env, never committed
# R2_ACCESS_KEY=                 # secret
# R2_SECRET_KEY=                 # secret

# --- Forgejo LFS → R2 (verified quirks baked in) ---
FORGEJO__lfs__STORAGE_TYPE=minio
FORGEJO__lfs__MINIO_BUCKET=forge-lfs
FORGEJO__lfs__MINIO_USE_SSL=true
FORGEJO__lfs__MINIO_CHECKSUM_ALGORITHM=md5   # R2 requirement (not sha256)
FORGEJO__lfs__SERVE_DIRECT=false             # start proxied; flip after spike C-item
                                             # passes (gitea issue #32407)

# --- platform caps (mirror of tools/lib/limits.mjs — single source is the code) ---
MAX_ASSET_MB=25
REPO_SOFT_CAP_GB=2
ALLOWED_ASSET_EXT=png,jpg,jpeg,webp,svg,ogg,mp3,woff2

# --- write-path law (SPEC §7, implemented in tools/lib/lfs.mjs + add-asset.mjs) ---
# Platform NEVER pushes binaries through the contents API (bypasses LFS).
# Sequence: LFS batch upload -> commit 3-line pointer atomically with JSON changes.
# Proven against tools/lfs-mock-server.mjs (same protocol, same R2 key layout);
# re-proven against real Forgejo+R2 by spike-checklist.md section C before Phase-1 code.
