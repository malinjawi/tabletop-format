# deploy/.env — copy to .env, fill in, NEVER commit the filled copy.

# Forgejo admin (created in DEPLOY.md step 2; the platform acts through this account)
FORGE_ADMIN_USER=root
FORGE_ADMIN_PASS=change-me-long-random
FORGE_TOKEN=            # minted in step 3
FORGE_PUBLIC_URL=http://localhost:3000/   # public URL if you expose the forge

# Secrets — generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LFS_JWT_SECRET=
PG_SUPER_PASS=
FORGE_DB_PASS=
PLATFORM_DB_PASS=

# Cloudflare R2 (LFS blob storage — decision D5)
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_LFS_BUCKET=forge-lfs
