# Public origins (no trailing slash). TLS terminates at the host proxy/CDN.
FORGE_PUBLIC_ORIGIN=https://forge.example
FORGEJO_PUBLIC_ORIGIN=https://git.forge.example
FORGE_BIND_IP=127.0.0.1
FORGEJO_BIND_PORT=3000

# Controlled-alpha registration. Rotate the invite code between cohorts.
FORGE_REGISTRATION_MODE=invite
FORGE_INVITE_CODE=replace-with-a-long-random-invite
FORGE_OPERATOR_NAME=Your organization or accountable name
FORGE_CONTACT_EMAIL=forge-support@example.com

# Runtime images MUST include @sha256:... . Promote a gateway build by digest;
# never point production Compose at a mutable local checkout.
FORGE_GATEWAY_IMAGE=registry.example/forge/platform@sha256:replace
FORGEJO_IMAGE=codeberg.org/forgejo/forgejo@sha256:replace-with-tested-digest
POSTGRES_IMAGE=postgres@sha256:replace-with-tested-digest

R2_ACCOUNT_ID=replace
R2_LFS_BUCKET=forge-lfs

# Secret values are files under deploy/.secrets/ (gitignored):
# forge-token, pg-super-password, forge-db-password, platform-db-password,
# forgejo-secret-key, forgejo-internal-token, forgejo-oauth2-jwt-secret,
# lfs-jwt-secret, r2-access-key, r2-secret-key. The four Forgejo signing and
# encryption values are recovery-critical and must be backed up separately in
# the same encrypted secret manager; never regenerate them during a restore.
# Generate database passwords with `openssl rand -base64 32`. Generate the
# Forgejo values with the tested Forgejo image, for example:
#   forgejo generate secret SECRET_KEY
#   forgejo generate secret INTERNAL_TOKEN
#   forgejo generate secret JWT_SECRET
#   forgejo generate secret LFS_JWT_SECRET
